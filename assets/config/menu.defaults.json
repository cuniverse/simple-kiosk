{
  "schemaVersion": 2,
  "layout": {
    "fontFamily": "Pretendard",
    "menuFontFamily": "Pretendard",
    "navPosition": "right",
    "sideWidth": 230,
    "barHeight": 102,
    "breakpoint": 720,
    "buttonHeight": 0,
    "buttonWidth": 0,
    "buttonGap": 10,
    "buttonAlignment": "stretch",
    "showHistoryButtons": true,
    "showKeyboardToggle": true,
    "showSelectedTopic": true,
    "selectedTopicLabelColor": "#f8fafc",
    "windowsKioskLockdown": true,
    "windowsDisableEdgeSwipe": true,
    "windowsKioskShortcuts": {
      "windowsKey": true,
      "altTab": true,
      "altEscape": true,
      "altF4": true,
      "altSpace": true,
      "ctrlEscape": true,
      "ctrlShiftEscape": true,
      "launchApp1": true,
      "launchApp2": true,
      "launchMail": true,
      "browserHome": true,
      "browserSearch": true,
      "browserFavorites": true
    },
    "windowsAlwaysOnTop": false,
    "windowsPreventScreenSaver": true,
    "windowsPreventDisplaySleep": true,
    "keyboardMode": "windows",
    "toolbarInitiallyHidden": false,
    "toolbarAutoHideSec": 0,
    "barColor": "#000000",
    "buttonColor": "#171717",
    "buttonForegroundColor": "#ffffff",
    "selectedButtonColor": "#facc15",
    "selectedButtonForegroundColor": "#000000",
    "keepStateOnTap": false
  },
  "idle": {
    "enabled": true,
    "timeoutSec": 300,
    "startOnLaunch": true,
    "modes": ["gallery"],
    "image": "assets/idle/welcome.jpg",
    "slideshow": {
      "intervalSec": 6,
      "transition": "fade",
      "images": [
        "assets/idle/slide1.jpg",
        "assets/idle/slide2.jpg",
        "assets/idle/slide3.jpg"
      ]
    },
    "folder": {
      "paths": ["assets/idle/"],
      "intervalSec": 8,
      "shuffle": true,
      "includeImages": true,
      "includeVideos": true,
      "transition": "fade"
    },
    "gallery": {
      "urls": [
        {
          "url": "http://ycatholic.or.kr/bbs/board.php?bo_table=gallery",
          "lookbackDays": 30,
          "minPosts": 1,
          "maxPosts": 100
        },
        {
          "url": "http://ycatholic.or.kr/bbs/board.php?bo_table=signage1",
          "minPosts": 1,
          "maxPosts": 10
        }
      ],
      "intervalSec": 8,
      "lookbackDays": 120,
      "minPosts": 1,
      "refreshIntervalMin": 5,
      "shuffle": true,
      "maxPosts": 10,
      "maxImages": 100,
      "transition": "fade"
    },
    "url": "https://example.com",
    "showHint": true,
    "hintText": "화면을 터치해 주세요"
  },
