{
  "schemaVersion": 1,
  "layout": {
    "navPosition": "bottom",
    "sideWidth": 220,
    "barHeight": 96,
    "breakpoint": 720,
    "buttonHeight": 0,
    "buttonWidth": 0,
    "buttonGap": 8,
    "buttonAlignment": "stretch",
    "showHistoryButtons": true,
    "showKeyboardToggle": true,
    "toolbarInitiallyHidden": true,
    "toolbarAutoHideSec": 20,
    "barColor": "#1f2937",
    "buttonColor": "#374151",
    "buttonForegroundColor": "#ffffff",
    "selectedButtonColor": "#2563eb",
    "selectedButtonForegroundColor": "#ffffff",
    "keepStateOnTap": false
  },
  "idle": {
    "enabled": true,
    "timeoutSec": 300,
    "startOnLaunch": true,
    "modes": ["gallery"],
    "image": "assets/idle/welcome.jpg",
    "slideshow": {
      "intervalSec": 6,
      "transition": "fade",
      "images": [
        "assets/idle/slide1.jpg",
        "assets/idle/slide2.jpg",
        "assets/idle/slide3.jpg"
      ]
    },
    "folder": {
      "paths": ["assets/idle/"],
      "intervalSec": 8,
      "shuffle": false,
      "includeImages": true,
      "includeVideos": true,
      "transition": "fade"
    },
    "gallery": {
      "urls": ["http://ycatholic.or.kr/bbs/board.php?bo_table=gallery"],
      "intervalSec": 8,
      "lookbackDays": 30,
      "minPosts": 1,
      "refreshIntervalMin": 5,
      "shuffle": false,
      "maxPosts": 10,
      "maxImages": 100,
      "transition": "fade"
    },
    "url": "https://example.com",
    "showHint": true,
    "hintText": "화면을 터치해 주세요"
  },
  "items": [
    {
      "id": "home",
      "title": "WYD 서울 2027",
      "url": "https://wydseoul.org/",
      "icon": "assets/icons/wyd-seoul-2027-toolbar-white.png",
      "showTitle": false
    },
    {
      "id": "notice",
      "title": "공지",
      "url": "http://ycatholic.or.kr/bbs/board.php?bo_table=notice",
      "icon": "icon:notice"
    },
    {
      "id": "gallery",
      "title": "포토갤러리",
      "url": "http://ycatholic.or.kr/bbs/board.php?bo_table=gallery",
      "icon": "icon:gallery"
    },
    {
      "id": "ycatholic",
      "title": "홈페이지",
      "url": "http://ycatholic.or.kr/",
      "icon": "icon:church",
      "keepStateOnTap": true
    },
    {
      "id": "jubo",
      "title": "주보",
      "url": "http://ycatholic.or.kr/bbs/board.php?bo_table=jubo&wr_id=2",
      "icon": "icon:book"
    }
  ]
}
